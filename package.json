{
  "name": "agent-crash-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local accident simulator for action-taking AI agents.",
  "license": "MIT",
  "author": "Ufodia",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate": "tsx cli/run.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
